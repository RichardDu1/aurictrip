---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Navigation from "@components/Navigation.astro";
import Footer from "@components/Footer.astro";
import JourneyListCard from "@components/JourneyListCard.astro";
import { journeySlug, itemListSchema, breadcrumbSchema } from "@lib/seo";
import { JOURNEY_TYPE_SLUGS } from "@lib/site-pages";

export async function getStaticPaths() {
  return JOURNEY_TYPE_SLUGS.map((type) => ({ params: { type } }));
}

export const prerender = true;

const { type } = Astro.params;
const journeys = await getCollection("journeys");
const filtered = journeys.filter(
  (j: CollectionEntry<"journeys">) =>
    j.data.priceLevel === type || type === "travel-styles",
);

interface TypeMeta {
  title: string;
  subtitle: string;
  desc: string;
  heroImage: string;
  whoFor: string;
}

const typeMeta: Record<string, TypeMeta> = {
  "travel-styles": {
    title: "旅行方式",
    subtitle: "每一种旅行，都是一种生活态度",
    desc: "从私人定制到臻选小团，从极地远征到亲子时光——找到最适合你的旅行形态。无论你想要什么样的旅行，我们都能为你实现。",
    heroImage: "/images/journeys/namibia-desert/namibia-desert-1.jpg",
    whoFor: "所有旅行者",
  },
  "鎏光臻选": {
    title: "鎏光臻选",
    subtitle: "精选顶级目的地，成熟线路呈现极致体验",
    desc: "每一条线路都经过实地勘察与反复打磨。行程、酒店、体验均已优化到极致——你只需出发，其余交给我们。适合追求确定性、不愿妥协的品味旅行者。",
    heroImage: "/images/journeys/tuscany-truffle/tuscany-truffle-1.jpg",
    whoFor: "追求极致体验、不愿妥协的品味旅行者",
  },
  "鎏光定制": {
    title: "鎏光定制",
    subtitle: "完全按你的设想，从零开始设计专属旅程",
    desc: "没有固定模板，没有现成路线。你的兴趣、节奏、预算——每一条线路都是唯一的。从灵感初现到行程定稿，我们的旅行设计师全程陪伴。适合知道自己想要什么的人。",
    heroImage: "/images/journeys/silk-road-heritage/silk-road-heritage-1.jpg",
    whoFor: "有明确旅行偏好、需要完全定制化的独立旅行者",
  },
  "鎏光远征": {
    title: "鎏光远征",
    subtitle: "深入地球最偏远的角落，探索真正的未知",
    desc: "为真正的探索者设计——南极大陆、巴塔哥尼亚荒野、撒哈拉深处。不是每个人都能到达的地方，正因如此才值得去。专业的极地/高海拔后勤保障，让你安全地走出舒适区。",
    heroImage: "/images/journeys/antarctica-expedition/antarctica-expedition-1.jpg",
    whoFor: "敢于挑战极限、渴望真正探险精神的硬核旅行者",
  },
};

const meta = typeMeta[type] || {
  title: type,
  subtitle: "",
  desc: "",
  heroImage: "",
  whoFor: "",
};

const jsonLd = [
  itemListSchema(
    meta.title,
    filtered.map((j: CollectionEntry<"journeys">) => ({
      name: `${j.data.destination} · ${j.data.label}`,
      path: `/journeys/${journeySlug(j.id)}`,
    })),
  ),
  breadcrumbSchema([
    { name: "首页", path: "/" },
    { name: "旅行形态", path: "/journey-types/travel-styles" },
    ...(type === "travel-styles" ? [] : [{ name: meta.title, path: `/journey-types/${type}` }]),
  ]),
];
---

<BaseLayout title={`${meta.title}：${meta.subtitle}`} description={meta.desc} image={meta.heroImage} jsonLd={jsonLd}>
  <Navigation />
  <main>
    <!-- Hero -->
    <section class="type-hero">
      <div
        class="type-hero-bg"
        style={`background-image: url(${meta.heroImage});`}
      ></div>
      <div class="type-hero-overlay"></div>
      <div class="type-hero-content">
        <p class="type-hero-label">
          {type === "travel-styles" ? "TRAVEL STYLES" : type}
        </p>
        <h1 class="type-hero-title">{meta.title}</h1>
        <p class="type-hero-subtitle">{meta.subtitle}</p>
      </div>
    </section>

    <!-- Intro -->
    <section class="type-intro">
      <div class="type-intro-inner">
        <p class="type-intro-text">{meta.desc}</p>
        {
          meta.whoFor && (
            <p class="type-intro-who">
              适合<span class="type-intro-who-highlight">{meta.whoFor}</span>
            </p>
          )
        }
      </div>
    </section>

    <!-- Journey list -->
    <section class="type-listing">
      <div class="type-listing-inner">
        {
          filtered.length === 0 ? (
            <p class="type-listing-empty">该分类下暂无旅程，敬请期待。</p>
          ) : (
            <div class="type-listing-grid">
              {filtered.map((j: CollectionEntry<"journeys">) => (
                <JourneyListCard journey={j} />
              ))}
            </div>
          )
        }
      </div>
    </section>

    <!-- CTA -->
    <section class="type-cta">
      <div class="type-cta-inner">
        <h2 class="type-cta-heading">准备好出发了吗？</h2>
        <p class="type-cta-text">
          与我们的旅行顾问聊聊你的想法。没有费用，没有义务——只是一次关于旅行的对话。
        </p>
        <a href="/contact" class="type-cta-link">与顾问对话 &rarr;</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  /* Hero */
  .type-hero {
    position: relative;
    height: 60vh;
    min-height: 380px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .type-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }
  .type-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      rgba(0, 0, 0, 0.25) 0%,
      rgba(0, 0, 0, 0.55) 100%
    );
  }
  .type-hero-content {
    position: relative;
    z-index: 1;
    padding: 3rem 2rem;
    max-width: 680px;
  }
  .type-hero-label {
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    color: var(--color-brand);
    margin-bottom: 0.75rem;
  }
  .type-hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    color: #fff;
    letter-spacing: 0.04em;
    margin-bottom: 0.5rem;
  }
  .type-hero-subtitle {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.8);
    letter-spacing: 0.04em;
  }

  /* Intro */
  .type-intro {
    padding: 4rem 2rem 2rem;
    background: var(--color-bg-page);
  }
  .type-intro-inner {
    max-width: var(--spacing-content-max);
    margin: 0 auto;
  }
  .type-intro-text {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.85;
    margin-bottom: 1.5rem;
  }
  .type-intro-who {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    letter-spacing: 0.03em;
  }
  .type-intro-who-highlight {
    color: var(--color-brand);
    margin-left: 0.25rem;
  }

  /* Listing */
  .type-listing {
    padding: 2rem 2rem 4rem;
    background: var(--color-bg-page);
  }
  .type-listing-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .type-listing-empty {
    text-align: center;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    padding: 3rem 0;
  }
  .type-listing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  @media (max-width: 1024px) {
    .type-listing-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* CTA */
  .type-cta {
    padding: 5rem 2rem;
    background: var(--color-bg-page);
    text-align: center;
  }
  .type-cta-inner {
    max-width: 480px;
    margin: 0 auto;
  }
  .type-cta-heading {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
  }
  .type-cta-text {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 2rem;
  }
  .type-cta-link {
    text-decoration: none;
    color: var(--color-brand);
    font-size: 1rem;
    letter-spacing: 0.04em;
  }

  @media (max-width: 768px) {
    .type-hero {
      height: 50vh;
      min-height: 300px;
    }
    .type-listing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>