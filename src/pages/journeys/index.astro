---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Navigation from "@components/Navigation.astro";
import Footer from "@components/Footer.astro";
import JourneyListCard from "@components/JourneyListCard.astro";
import { journeySlug, itemListSchema, breadcrumbSchema } from "@lib/seo";

export const prerender = true;

const journeys = await getCollection("journeys");
const sorted = journeys
  .map((j: CollectionEntry<"journeys">) => j)
  .sort((a: CollectionEntry<"journeys">, b: CollectionEntry<"journeys">) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return a.data.price - b.data.price;
  });

const jsonLd = [
  itemListSchema(
    "鎏光旅行全部旅程",
    sorted.map((j: CollectionEntry<"journeys">) => ({
      name: `${j.data.destination} · ${j.data.label}`,
      path: `/journeys/${journeySlug(j.id)}`,
    })),
  ),
  breadcrumbSchema([
    { name: "首页", path: "/" },
    { name: "全部旅程", path: "/journeys" },
  ]),
];
---

<BaseLayout
  title={`全部${sorted.length}条高端定制旅程：目的地、天数与指导价`}
  description={`鎏光旅行全部${sorted.length}条全球高端定制旅程一览：覆盖非洲野奢、欧洲深度、亚洲文化与南极北极远征，逐条列出天数、最佳季节与人民币指导价，可按需私人定制。`}
  jsonLd={jsonLd}
>
  <Navigation />
  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <h1 class="page-hero-title">全部旅程</h1>
        <p class="page-hero-sub">每一段旅程，皆为私人定制。价格为指导价，详询旅行顾问。</p>
      </div>
    </section>

    <section class="listing">
      <div class="listing-inner">
        <div class="listing-grid">
          {sorted.map((j: CollectionEntry<"journeys">) => (
            <JourneyListCard journey={j} />
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-hero {
    padding: 8rem 2rem 3rem;
    background: var(--color-bg-page);
    text-align: center;
  }
  .page-hero-inner {
    max-width: 680px;
    margin: 0 auto;
  }
  .page-hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
  }
  .page-hero-sub {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
  .listing {
    padding: 3rem 2rem;
    background: var(--color-bg-page);
  }
  .listing-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .listing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  @media (max-width: 1024px) {
    .listing-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 768px) {
    .listing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>