---
import BaseLayout from "@layouts/BaseLayout.astro";
import Navigation from "@components/Navigation.astro";
import Hero from "@components/Hero.astro";
import TrustBar from "@components/TrustBar.astro";
import AudienceEntry from "@components/AudienceEntry.astro";
import EmotionEngine from "@components/EmotionEngine.astro";
import IPProductLines from "@components/IPProductLines.astro";
import JourneyCards from "@components/JourneyCards.astro";
import ExpertTeam from "@components/ExpertTeam.astro";
import CustomizationFlow from "@components/CustomizationFlow.astro";
import CustomerStories from "@components/CustomerStories.astro";
import CTA from "@components/CTA.astro";
import Footer from "@components/Footer.astro";
import { getCollection } from "astro:content";
import { organizationSchema, websiteSchema } from "@lib/seo";

const journeyCount = (await getCollection("journeys")).length;
---

<BaseLayout
  title="鎏光旅行 AuricTrip｜伦敦团队的全球高端定制旅行，全程中文服务"
  fullTitle
  description={`鎏光旅行 AuricTrip，团队扎根伦敦，为中国旅行者设计全球高端定制旅程：${journeyCount}条行程覆盖非洲野奢、欧洲深度、亚洲文化与南北极远征，具名酒店、费用透明、48小时出方案、全程中文管家。`}
  jsonLd={[organizationSchema, websiteSchema]}
>
  <Navigation />
  <main>
    <Hero />
    <TrustBar />
    <AudienceEntry />
    <EmotionEngine />
    <IPProductLines />
    <JourneyCards />
    <ExpertTeam />
    <CustomizationFlow />
    <CustomerStories />
    <CTA />
  </main>
  <Footer />
</BaseLayout>