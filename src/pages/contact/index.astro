---
import BaseLayout from "@layouts/BaseLayout.astro";
import Navigation from "@components/Navigation.astro";
import Footer from "@components/Footer.astro";
import WeChatShare from "@components/WeChatShare.astro";
---

<BaseLayout title="联系旅行顾问：电话、WhatsApp、微信与邮箱" description="联系鎏光旅行顾问：电话/WhatsApp +44 7396 800888，邮箱 service@aurictrip.com，微信 PanEuroTrip。告诉我们目的地、出行时间与人数，即可开始定制你的专属行程。">
  <Navigation />
  <main>
    <section class="page-hero">
      <div class="page-hero-inner">
        <h1 class="page-hero-title">联系我们</h1>
        <p class="page-hero-sub">每一次旅程，都从一次对话开始</p>
      </div>
    </section>

    <section class="contact">
      <div class="contact-inner">
        <div class="contact-grid">
          <div class="contact-info">
            <h2 class="contact-heading">与旅行顾问对话</h2>
            <p class="contact-intro">
              告诉我们你的旅行偏好、时间与期待。我们将在48小时内为你提交专属行程方案。没有费用，没有义务——只是一次关于旅行的对话。
            </p>

            <div class="contact-methods">
              <div class="contact-method">
                <strong class="cm-label">电话</strong>
                <p class="cm-value">+44 7396 800888</p>
                <p class="cm-note">英国手机号 · 支持 WhatsApp · 周一至周五 9:00-18:00 (GMT)</p>
              </div>
              <div class="contact-method">
                <strong class="cm-label">邮件</strong>
                <p class="cm-value">service@aurictrip.com</p>
                <p class="cm-note">我们通常在24小时内回复</p>
              </div>
              <div class="contact-method">
                <strong class="cm-label">微信</strong>
                <p class="cm-value">PanEuroTrip</p>
                <p class="cm-note">添加微信，随时沟通旅行计划</p>
              </div>
            </div>
          </div>

          <div class="contact-form-wrapper">
            <h2 class="contact-heading">快速咨询</h2>
            <form class="contact-form" data-contact-form novalidate>
              <div class="form-group">
                <label class="form-label" for="name">姓名</label>
                <input type="text" id="name" name="name" autocomplete="name" class="form-input" placeholder="您的姓名" />
              </div>
              <p class="form-hint">以下联系方式至少填写一项</p>
              <div class="form-group">
                <label class="form-label" for="phone">电话 / WhatsApp</label>
                <input type="tel" id="phone" name="phone" autocomplete="tel" class="form-input" placeholder="+86 138 0000 0000 或 +44 7396 800888" />
              </div>
              <div class="form-group">
                <label class="form-label" for="wechat">微信号</label>
                <input type="text" id="wechat" name="wechat" class="form-input" placeholder="您的微信号" />
              </div>
              <div class="form-group">
                <label class="form-label" for="email">邮箱</label>
                <input type="email" id="email" name="email" autocomplete="email" class="form-input" placeholder="your@email.com" />
              </div>
              <div class="form-group">
                <label class="form-label" for="contact_method">希望我们如何联系您</label>
                <select id="contact_method" name="contact_method" class="form-input">
                  <option value="微信">微信</option>
                  <option value="电话">电话</option>
                  <option value="WhatsApp">WhatsApp</option>
                  <option value="邮件">邮件</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label" for="tour">感兴趣的行程或目的地</label>
                <input type="text" id="tour" name="tour" class="form-input" placeholder="例如：日本、意大利、南极..." />
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label" for="start_date">计划出发日期</label>
                  <input type="date" id="start_date" name="start_date" class="form-input" />
                </div>
                <div class="form-group">
                  <label class="form-label" for="end_date">计划返回日期</label>
                  <input type="date" id="end_date" name="end_date" class="form-input" />
                </div>
              </div>
              <div class="form-group">
                <label class="form-label" for="message">旅行需求</label>
                <textarea id="message" name="message" class="form-textarea" rows="4" placeholder="告诉我们出行人数、预算范围、旅行偏好..."></textarea>
              </div>
              <button type="submit" class="form-submit" data-submit>提交咨询 &rarr;</button>
              <p class="form-status" data-form-status role="status" aria-live="polite" hidden></p>
              <p class="form-note">提交即表示你同意我们通过你留下的联系方式与你联系。我们不会将你的信息分享给第三方。</p>
            </form>
            <div class="form-result form-result-ok" data-form-success hidden>
              <h3>咨询已提交</h3>
              <p>我们已收到你的需求，旅行顾问会通过你留下的联系方式与你联系。</p>
            </div>
          </div>
        </div>
        <WeChatShare />
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  // 提交到 Highland Travel 集团表单系统；只有 response.ok 才显示成功，失败时给出备用联系方式
  const FORM_ENDPOINT = "https://form.highland-travel.com";
  const FALLBACK = "提交失败，请直接通过电话/WhatsApp +44 7396 800888、微信 PanEuroTrip 或邮箱 service@aurictrip.com 联系我们。";
  const CONTACT_FIELDS = ["phone", "wechat", "email"];

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const submitBtn = form?.querySelector<HTMLButtonElement>("[data-submit]");
  const status = form?.querySelector<HTMLElement>("[data-form-status]");
  const success = document.querySelector<HTMLElement>("[data-form-success]");

  // 从详情页"与顾问对话"带过来的行程名
  const tourParam = new URLSearchParams(window.location.search).get("tour");
  const tourInput = form?.querySelector<HTMLInputElement>("#tour");
  if (tourParam && tourInput && !tourInput.value) tourInput.value = tourParam;

  function showStatus(text: string) {
    if (!status) return;
    status.textContent = text;
    status.hidden = false;
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const raw = Object.fromEntries(
      [...new FormData(form).entries()].map(([k, v]) => [k, String(v).trim()]),
    ) as Record<string, string>;
    if (!CONTACT_FIELDS.some((k) => raw[k])) {
      showStatus("请至少填写电话、微信或邮箱中的一项，方便我们联系你。");
      return;
    }
    const payload = {
      name: raw.name,
      phone: raw.phone,
      wechat: raw.wechat,
      email: raw.email,
      address: "",
      start_date: raw.start_date,
      end_date: raw.end_date,
      tour: raw.tour || document.title,
      contact_method: raw.contact_method,
      message: [raw.message, `来源页面：${window.location.href}`].filter(Boolean).join("\n"),
    };

    const originalText = submitBtn?.innerHTML ?? "";
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "正在提交…";
    }
    if (status) status.hidden = true;
    try {
      const response = await fetch(FORM_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      form.hidden = true;
      if (success) success.hidden = false;
      const w = window as unknown as { gtag?: (...args: unknown[]) => void };
      w.gtag?.("event", "generate_lead", { form: "contact", tour: payload.tour });
    } catch {
      showStatus(FALLBACK);
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
      }
    }
  });
</script>

<style>
  .page-hero {
    padding: 8rem 2rem 3rem;
    background: var(--color-bg-page);
    text-align: center;
  }
  .page-hero-inner {
    max-width: 680px;
    margin: 0 auto;
  }
  .page-hero-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
  }
  .page-hero-sub {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
  .contact {
    padding: 4rem 2rem;
    background: var(--color-bg-page);
  }
  .contact-inner {
    max-width: 1000px;
    margin: 0 auto;
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }
  .contact-heading {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
    letter-spacing: 0.03em;
  }
  .contact-intro {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.75;
    margin-bottom: 2rem;
  }
  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .cm-label {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--color-brand);
    margin-bottom: 0.25rem;
  }
  .cm-value {
    font-family: var(--font-heading);
    font-size: 1rem;
    color: var(--color-text-primary);
    margin-bottom: 0.15rem;
  }
  .cm-note {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0;
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .form-group {
    display: flex;
    flex-direction: column;
  }
  .form-label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-bottom: 0.35rem;
  }
  .form-input,
  .form-textarea {
    padding: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-text-muted) 25%, transparent);
    background: var(--color-bg-card);
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-text-primary);
    resize: vertical;
  }
  .form-input:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--color-brand);
  }
  .form-submit {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 2rem;
    border: 1px solid var(--color-brand);
    background: transparent;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-brand);
    cursor: pointer;
    letter-spacing: 0.03em;
    transition: background 0.2s, color 0.2s;
    align-self: flex-start;
  }
  .form-submit:hover {
    background: var(--color-brand);
    color: #fff;
  }
  .form-hint {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: -0.25rem 0 0.75rem;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  @media (max-width: 480px) {
    .form-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
  .form-status {
    margin-top: 1rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: #a3392f;
  }
  .form-result {
    padding: 1.5rem;
    border: 1px solid color-mix(in srgb, var(--color-brand) 40%, transparent);
    background: var(--color-bg-card);
  }
  .form-result h3 {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }
  .form-result p {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }
  .form-note {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }
  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>