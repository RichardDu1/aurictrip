---
interface Props {
  destination: string;
  subtitle?: string;
  price: number;
  days: number;
  nights: number;
  priceLevel: string;
  season: string;
}

const { destination, subtitle, price, days, nights, priceLevel, season } = Astro.props;
---

<div class="title-price">
  <div class="tp-tag">{priceLevel}</div>
  <h1 class="tp-title">{destination}</h1>
  {subtitle && <p class="tp-subtitle">{subtitle}</p>}
  <div class="tp-meta">
    <span>{days}天{nights}晚</span>
    <span class="tp-sep">·</span>
    <span>最佳季节：{season}</span>
  </div>
  <p class="tp-price">¥{price.toLocaleString()}<span class="tp-price-suffix">起/人</span></p>
  <p class="tp-disclaimer">参考价，将根据出行人数、季节和定制需求有所调整</p>
</div>

<style>
  .title-price {
    max-width: var(--spacing-content-max);
    margin: 0 auto;
    padding: 3rem 2rem 2rem;
  }
  .tp-tag {
    display: inline-block;
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    color: var(--color-brand);
    margin-bottom: 0.75rem;
  }
  .tp-title {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
    letter-spacing: 0.02em;
  }
  .tp-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
    line-height: 1.6;
  }
  .tp-meta {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }
  .tp-sep {
    margin: 0 0.5rem;
  }
  .tp-price {
    font-family: var(--font-price);
    font-size: 2rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 0.35rem;
  }
  .tp-price-suffix {
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--color-text-muted);
    margin-left: 0.25rem;
  }
  .tp-disclaimer {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }
</style>