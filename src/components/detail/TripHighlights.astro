---
interface Props {
  highlights: string[];
}

const { highlights } = Astro.props;
if (!highlights || highlights.length === 0) return;
---

<section class="highlights">
  <div class="hl-head">
    <span class="hl-eyebrow">HIGHLIGHTS</span>
    <h2 class="hl-heading">此行亮点</h2>
    <p class="hl-sub">这趟旅程最值得期待的几个瞬间</p>
  </div>
  <div class="hl-grid">
    {highlights.map((h, i) => (
      <article class="hl-item">
        <span class="hl-no">{String(i + 1).padStart(2, "0")}</span>
        <div class="hl-body">
          <span class="hl-icon">&#9670;</span>
          <p class="hl-text">{h}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .highlights {
    max-width: var(--spacing-content-max);
    margin: 0 auto;
    padding: 3rem 2rem 0;
  }
  .hl-head {
    margin-bottom: 2rem;
  }
  .hl-eyebrow {
    display: block;
    font-size: 0.62rem;
    letter-spacing: 0.25em;
    color: var(--color-brand);
    margin-bottom: 0.6rem;
  }
  .hl-heading {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 0.4rem;
    letter-spacing: 0.03em;
  }
  .hl-sub {
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }
  .hl-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border-top: 1px solid color-mix(in srgb, var(--color-text-muted) 14%, transparent);
    border-left: 1px solid color-mix(in srgb, var(--color-text-muted) 14%, transparent);
  }
  .hl-item {
    display: flex;
    gap: 1.25rem;
    padding: 1.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-text-muted) 14%, transparent);
    border-right: 1px solid color-mix(in srgb, var(--color-text-muted) 14%, transparent);
  }
  .hl-no {
    flex-shrink: 0;
    font-family: var(--font-price);
    font-size: 0.9rem;
    color: var(--color-brand);
    letter-spacing: 0.05em;
  }
  .hl-body {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }
  .hl-icon {
    flex-shrink: 0;
    font-size: 0.55rem;
    color: var(--color-brand);
    margin-top: 0.35rem;
    opacity: 0.7;
  }
  .hl-text {
    font-size: 0.88rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }
  @media (max-width: 768px) {
    .hl-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
