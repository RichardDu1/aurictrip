---
interface Props {
  highlights: string[];
}

const { highlights } = Astro.props;
if (!highlights || highlights.length === 0) return;
---

<section class="highlights">
  <h2 class="hl-heading">行程亮点</h2>
  <div class="hl-grid">
    {highlights.map((h) => (
      <div class="hl-item">
        <span class="hl-icon">&#9670;</span>
        <p class="hl-text">{h}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .highlights {
    max-width: var(--spacing-content-max);
    margin: 0 auto;
    padding: 2rem 2rem 0;
  }
  .hl-heading {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 1.5rem;
    letter-spacing: 0.03em;
  }
  .hl-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .hl-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .hl-icon {
    flex-shrink: 0;
    font-size: 0.6rem;
    color: var(--color-brand);
    margin-top: 0.3rem;
  }
  .hl-text {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }
  @media (max-width: 768px) {
    .hl-grid {
      grid-template-columns: 1fr;
    }
  }
</style>