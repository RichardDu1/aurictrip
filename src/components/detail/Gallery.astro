---
export interface Props {
  images: string[];
  alt: string;
}

const { images, alt } = Astro.props;
const hasGallery = images && images.length > 0;
const main = hasGallery ? images[0] : "";
const thumbs = hasGallery ? images.slice(1) : [];
---

{hasGallery ? (
  <div class="gallery" data-gallery>
    <div class="gallery-main">
      <img
        src={main}
        alt={alt}
        class="gallery-main-img"
        loading="eager"
        decoding="async"
        data-gallery-main
      />
    </div>
    {thumbs.length > 0 && (
      <div class="gallery-thumbs">
        <button
          type="button"
          class="gallery-thumb is-active"
          data-gallery-thumb
          data-index="0"
          aria-label="查看第 1 张"
        >
          <img src={main} alt="" loading="lazy" decoding="async" />
        </button>
        {thumbs.map((src, i) => (
          <button
            type="button"
            class="gallery-thumb"
            data-gallery-thumb
            data-index={String(i + 1)}
            aria-label={`查看第 ${i + 2} 张`}
          >
            <img src={src} alt="" loading="lazy" decoding="async" />
          </button>
        ))}
      </div>
    )}
  </div>
) : null}

<style>
  .gallery {
    max-width: var(--spacing-content-max);
    margin: 0 auto;
    padding: 0 2rem 1rem;
  }
  .gallery-main {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--color-bg-warm);
    overflow: hidden;
  }
  .gallery-main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.3s ease;
  }
  .gallery-thumbs {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .gallery-thumb {
    border: none;
    background: var(--color-bg-warm);
    padding: 0;
    cursor: pointer;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    opacity: 0.65;
    transition: opacity 0.2s;
  }
  .gallery-thumb:hover,
  .gallery-thumb.is-active {
    opacity: 1;
  }
  .gallery-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 768px) {
    .gallery-thumbs {
      grid-template-columns: repeat(5, 1fr);
      gap: 0.5rem;
    }
    .gallery-main {
      aspect-ratio: 3 / 2;
    }
  }
</style>

<script>
  function initGallery(root: HTMLElement) {
    const main = root.querySelector<HTMLImageElement>("[data-gallery-main]");
    const thumbs = root.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]");
    if (!main || thumbs.length === 0) return;

    thumbs.forEach((thumb) => {
      thumb.addEventListener("click", () => {
        const img = thumb.querySelector("img");
        if (!img) return;
        main.style.opacity = "0";
        window.setTimeout(() => {
          main.src = img.src;
          main.style.opacity = "1";
        }, 150);
        thumbs.forEach((t) => t.classList.remove("is-active"));
        thumb.classList.add("is-active");
      });
    });
  }

  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach(initGallery);
</script>
