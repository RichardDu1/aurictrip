---
export interface Props {
  images: string[];
  alt: string;
}

const { images, alt } = Astro.props;
const hasGallery = images && images.length > 0;
const main = hasGallery ? images[0] : "";
const thumbs = hasGallery ? images.slice(1) : [];
---

{hasGallery ? (
  <div class="gallery" data-gallery>
    <div class="gallery-main">
      <img
        src={main}
        alt={alt}
        class="gallery-main-img"
        loading="eager"
        decoding="async"
        data-gallery-main
      />
      <div class="gallery-main-overlay">
        <span class="gallery-counter" data-gallery-counter>1 / {images.length}</span>
      </div>
    </div>
    {thumbs.length > 0 && (
      <div class="gallery-thumbs">
        <button
          type="button"
          class="gallery-thumb is-active"
          data-gallery-thumb
          data-index="0"
          aria-label="查看第 1 张"
        >
          <img src={main} alt="" loading="lazy" decoding="async" />
        </button>
        {thumbs.map((src, i) => (
          <button
            type="button"
            class="gallery-thumb"
            data-gallery-thumb
            data-index={String(i + 1)}
            aria-label={`查看第 ${i + 2} 张`}
          >
            <img src={src} alt="" loading="lazy" decoding="async" />
          </button>
        ))}
      </div>
    )}
  </div>
) : null}

<style>
  .gallery {
    width: 100%;
    margin: 0;
    padding: 0;
  }
  .gallery-main {
    position: relative;
    width: 100%;
    aspect-ratio: 21 / 9;
    background: var(--color-bg-warm);
    overflow: hidden;
  }
  .gallery-main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.4s ease, transform 6s ease;
    transform: scale(1);
  }
  .gallery-main-overlay {
    position: absolute;
    bottom: 0;
    right: 0;
    padding: 1.25rem 1.5rem;
    background: linear-gradient(135deg, transparent, rgba(0, 0, 0, 0.45));
    pointer-events: none;
  }
  .gallery-counter {
    font-family: var(--font-price);
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: 0.08em;
  }
  .gallery-thumbs {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 4px;
    margin: 0;
  }
  .gallery-thumb {
    border: none;
    background: var(--color-bg-warm);
    padding: 0;
    cursor: pointer;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    opacity: 0.55;
    transition: opacity 0.3s;
    position: relative;
  }
  .gallery-thumb::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-bg-page);
    opacity: 0.4;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .gallery-thumb:hover,
  .gallery-thumb.is-active {
    opacity: 1;
  }
  .gallery-thumb:hover::after,
  .gallery-thumb.is-active::after {
    opacity: 0;
  }
  .gallery-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 768px) {
    .gallery-main {
      aspect-ratio: 4 / 3;
    }
    .gallery-thumbs {
      grid-template-columns: repeat(5, 1fr);
      gap: 3px;
    }
  }
</style>

<script>
  function initGallery(root: HTMLElement) {
    const main = root.querySelector<HTMLImageElement>("[data-gallery-main]");
    const counter = root.querySelector<HTMLElement>("[data-gallery-counter]");
    const thumbs = root.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]");
    const total = thumbs.length;
    if (!main || thumbs.length === 0) return;

    thumbs.forEach((thumb) => {
      thumb.addEventListener("click", () => {
        const img = thumb.querySelector("img");
        if (!img) return;
        main.style.opacity = "0";
        window.setTimeout(() => {
          main.src = img.src;
          main.style.opacity = "1";
        }, 200);
        thumbs.forEach((t) => t.classList.remove("is-active"));
        thumb.classList.add("is-active");
        if (counter) {
          const index = Number(thumb.dataset.index) + 1;
          counter.textContent = `${index} / ${total}`;
        }
      });
    });
  }

  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach(initGallery);
</script>
