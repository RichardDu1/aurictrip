---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

export const prerender = true;

interface CardJourney {
  label: string;
  title: string;
  days: string;
  href: string;
  image: string;
  price: number;
  priceLevel: string;
}

const all = await getCollection("journeys");
const featured = all
  .filter((j: CollectionEntry<"journeys">) => j.data.featured)
  .sort((a: CollectionEntry<"journeys">, b: CollectionEntry<"journeys">) => a.data.price - b.data.price);

// 若 featured 不足 6 条，用 price 升序补齐
if (featured.length < 6) {
  const others = all
    .filter((j: CollectionEntry<"journeys">) => !j.data.featured)
    .sort((a: CollectionEntry<"journeys">, b: CollectionEntry<"journeys">) => a.data.price - b.data.price);
  for (const j of others) {
    if (featured.length >= 6) break;
    featured.push(j);
  }
}

const journeys: CardJourney[] = featured.slice(0, 6).map((j: CollectionEntry<"journeys">) => ({
  label: j.data.label,
  title: `${j.data.destination} ${j.data.days}天${j.data.nights}晚 ${j.data.subtitle ?? ""}`.trim(),
  days: `${j.data.days}天${j.data.nights}晚`,
  href: `/journeys/${j.id.replace(/\.md$/, "")}`,
  image: j.data.heroImage ?? "",
  price: j.data.price,
  priceLevel: j.data.priceLevel,
}));
---

<section class="journeys">
  <div class="journeys-inner">
    <h2 class="journeys-heading">精选旅程</h2>
    <p class="journeys-sub">每一段旅程，皆为私人定制。价格为参考起价，详询旅行顾问。</p>
    <div class="journeys-grid">
      {journeys.map((j) => (
        <a href={j.href} class="journey-card card">
          <div
            class="journey-card-img"
            style={j.image ? `background-image: url(${j.image});` : ""}
          ></div>
          <div class="journey-card-body">
            <span class="journey-card-label">{j.label}</span>
            <h3 class="journey-card-title">{j.title}</h3>
            <span class="journey-card-days">{j.days}</span>
            <div class="journey-card-price">
              <span class="journey-card-price-tag">{j.priceLevel}</span>
              <span class="journey-card-price-num">¥{j.price.toLocaleString()}<span class="journey-card-price-suffix">起/人 · 指导价</span></span>
            </div>
            <span class="journey-card-action">了解详情 &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .journeys {
    padding: var(--spacing-section) 2rem;
    background: var(--color-bg-page);
  }
  .journeys-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .journeys-heading {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    text-align: center;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
    letter-spacing: 0.04em;
  }
  .journeys-sub {
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 3rem;
  }
  .journeys-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-card-gap);
  }
  .journey-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    min-height: 280px;
    text-decoration: none;
    background: var(--color-bg-card);
    transition: opacity 0.2s;
  }
  .journey-card:hover {
    opacity: 0.7;
  }
  .journey-card-img {
    min-height: 280px;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-color: var(--color-bg-warm);
  }
  .journey-card-body {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .journey-card-label {
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    color: var(--color-brand);
    margin-bottom: 0.75rem;
  }
  .journey-card-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.5;
    margin-bottom: 1rem;
  }
  .journey-card-days {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }
  .journey-card-price {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-bottom: 1rem;
  }
  .journey-card-price-tag {
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    color: var(--color-brand);
  }
  .journey-card-price-num {
    font-family: var(--font-price);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }
  .journey-card-price-suffix {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 400;
    color: var(--color-text-muted);
    margin-left: 0.2rem;
  }
  .journey-card-action {
    font-size: 0.8rem;
    color: var(--color-brand);
  }

  @media (max-width: 768px) {
    .journeys-grid {
      grid-template-columns: 1fr;
    }
    .journey-card {
      grid-template-columns: 1fr;
    }
    .journey-card-img {
      min-height: 200px;
    }
  }
</style>
