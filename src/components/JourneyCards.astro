---
interface Journey {
  label: string;
  title: string;
  days: string;
  href: string;
  image: string;
}

const journeys: Journey[] = [
  {
    label: "暹罗秘境",
    title: "泰国 11天10晚 从曼谷的寺庙到安达曼海的私人岛屿",
    days: "11天10晚",
    href: "/journeys/thailand-siam",
    image:
      "https://images.unsplash.com/photo-1552465011-b4e21bf6e79a?w=800&q=80&auto=format&fit=crop",
  },
  {
    label: "众神之岛",
    title: "巴厘岛 10天9晚 从乌布稻田到乌鲁瓦图的悬崖之巅",
    days: "10天9晚",
    href: "/journeys/bali-islands",
    image:
      "https://images.unsplash.com/photo-1537996194471-e657df975ab4?w=800&q=80&auto=format&fit=crop",
  },
  {
    label: "旷野呼唤",
    title: "肯尼亚 10天9晚 马赛马拉的星空与角马大迁徙",
    days: "10天9晚",
    href: "/journeys/kenya-safari",
    image:
      "https://images.unsplash.com/photo-1516426122078-c23e76319801?w=800&q=80&auto=format&fit=crop",
  },
  {
    label: "野性之美",
    title: "南非 11天10晚 从桌山之巅到克鲁格国家公园",
    days: "11天10晚",
    href: "/journeys/south-africa",
    image:
      "https://images.unsplash.com/photo-1484318571209-661cf29a69c5?w=800&q=80&auto=format&fit=crop",
  },
  {
    label: "日出之国",
    title: "日本 12天11晚 从东京安缦到京都岚山深处",
    days: "12天11晚",
    href: "/journeys/japan-odyssey",
    image:
      "https://images.unsplash.com/photo-1528360983277-13d401cdc186?w=800&q=80&auto=format&fit=crop",
  },
  {
    label: "安达卢西亚之梦",
    title: "西班牙 10天9晚 弗拉明戈与阿尔罕布拉宫的阿拉伯之梦",
    days: "10天9晚",
    href: "/journeys/spain-andalusia",
    image:
      "https://images.unsplash.com/photo-1543783207-ec64e4d95325?w=800&q=80&auto=format&fit=crop",
  },
];
---

<section class="journeys">
  <div class="journeys-inner">
    <h2 class="journeys-heading">精选旅程</h2>
    <p class="journeys-sub">每一段旅程，皆为私人定制。价格详询旅行顾问。</p>
    <div class="journeys-grid">
      {journeys.map((j) => (
        <a href={j.href} class="journey-card card">
          <div
            class="journey-card-img"
            style={`background-image: url(${j.image});`}
          ></div>
          <div class="journey-card-body">
            <span class="journey-card-label">{j.label}</span>
            <h3 class="journey-card-title">{j.title}</h3>
            <span class="journey-card-days">{j.days}</span>
            <span class="journey-card-action">了解详情 &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .journeys {
    padding: var(--spacing-section) 2rem;
    background: var(--color-bg-page);
  }
  .journeys-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .journeys-heading {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    text-align: center;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
    letter-spacing: 0.04em;
  }
  .journeys-sub {
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 3rem;
  }
  .journeys-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-card-gap);
  }
  .journey-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    min-height: 280px;
    text-decoration: none;
    background: var(--color-bg-card);
    transition: opacity 0.2s;
  }
  .journey-card:hover {
    opacity: 0.7;
  }
  .journey-card-img {
    min-height: 280px;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-color: var(--color-bg-warm);
  }
  .journey-card-body {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .journey-card-label {
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    color: var(--color-brand);
    margin-bottom: 0.75rem;
  }
  .journey-card-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }
  .journey-card-days {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }
  .journey-card-action {
    font-size: 0.8rem;
    color: var(--color-brand);
  }

  @media (max-width: 768px) {
    .journeys-grid {
      grid-template-columns: 1fr;
    }
    .journey-card {
      grid-template-columns: 1fr;
    }
    .journey-card-img {
      min-height: 200px;
    }
  }
</style>