---
interface Guarantee {
  title: string;
  desc: string;
}
const guarantees: Guarantee[] = [
  { title: "ATOL/ABTA 保护", desc: "英国注册·资金法定托管" },
  { title: "48 小时方案", desc: "具名酒店·指导价·非询价回执" },
  { title: "24/7 中文管家", desc: "欧洲端专车·母语伴随" },
  { title: "30 天免费改期", desc: "条款透明·不可抗力全退" },
  { title: "品牌直签", desc: "实地考察·无隐藏费用" },
];
---

<section class="trust-bar">
  <div class="trust-inner">
    {guarantees.map((g) => (
      <div class="trust-item">
        <strong class="trust-title">{g.title}</strong>
        <p class="trust-desc">{g.desc}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .trust-bar {
    background: var(--color-bg-card);
    border-bottom: 1px solid color-mix(in srgb, var(--color-text-muted) 12%, transparent);
    padding: 1.5rem 2rem;
  }
  .trust-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem;
  }
  .trust-item {
    text-align: center;
  }
  .trust-title {
    display: block;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.35rem;
    letter-spacing: 0.05em;
  }
  .trust-desc {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .trust-inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>